<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>dotnet-LighthouseManagerService-4E75BA58-216C-424C-92EF-66AB1E1C4CF6</UserSecretsId>
    <!-- Reflection-free AppSettings binding and minimal API endpoints, required for trimmed publishes -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- API only, no static files -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Self-hosted Kestrel, no IIS: no web.config / ASP.NET Core Module in the output -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <Target Name="RemoveAspNetCoreModuleFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'aspnetcorev2_inprocess'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Trimming removes X509Certificate2Collection.GetEnumerator, which Kestrel's config loader needs at startup -->
    <TrimmerRootAssembly Include="System.Security.Cryptography" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LighthouseManager.Core\LighthouseManager.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LighthouseManager.Tests" />
  </ItemGroup>
</Project>
